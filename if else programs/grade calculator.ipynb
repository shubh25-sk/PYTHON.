   "source": [
    "\n",
    "a=int(input(\"enter marks \"))\n",
    "if a>=90 :\n",
    "    print(\"A grade\")\n",
    "elif a>=75:\n",
    "    print(\"B grade\") \n",
    "elif a>=60 :\n",
    "    print(\"C grade\")\n",
    "elif a>=50 :\n",
    "    print(\"D grade\")\n",
    "elif a>=35 :\n",
    "    print(\"E grade\")\n",
    "else :\n",
    "    print(\"fail\")"
   ]
